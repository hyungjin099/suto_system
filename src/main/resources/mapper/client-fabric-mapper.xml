<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dream_comp.auto_system.mapper.ClientFabricMapper">

    <resultMap id="clientFabricResultMap" type="com.dream_comp.auto_system.dto.ClientFabricDto">
        <result property="aliasName"       column="ALIAS_NAME"/>
        <result property="prodCode"        column="PROD_CODE"/>
        <result property="prodName"        column="PROD_NAME"/>
        <result property="clientFabPrice"  column="CLIENT_FAB_PRICE"/>
    </resultMap>

    <!--
        고객사 CLI_CODE(거래처코드)로 해당 고객사에 등록된 원단 별칭 목록 조회.
        셀렉트박스: aliasName 표시 / 주문 저장: prodCode·prodName 사용
    -->
    <select id="findByCliCode" parameterType="string" resultMap="clientFabricResultMap">
        SELECT
            cfa.CLIENT_FAB_NAME  AS ALIAS_NAME,
            pi.PROD_CODE         AS PROD_CODE,
            pi.PROD_NAME         AS PROD_NAME,
            cfa.CLIENT_FAB_PRICE AS CLIENT_FAB_PRICE
        FROM CLIENT_FABRIC_ALIAS cfa
        JOIN PRODUCT_INFO pi ON pi.PROD_NUM = cfa.PROD_NUM
        JOIN CLIENT_INFO  ci ON ci.CLI_NUM  = cfa.CLI_NUM
        WHERE ci.CLI_CODE = #{cliCode}
        ORDER BY pi.PROD_NAME
    </select>

</mapper>
