<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dream_comp.auto_system.mapper.SupplierMapper">

    <resultMap id="supplierResultMap" type="com.dream_comp.auto_system.dto.SupplierDto">
        <id     property="supNum"  column="SUP_NUM"/>
        <result property="supName" column="SUP_NAME"/>
    </resultMap>

    <select id="findAll" resultMap="supplierResultMap">
        SELECT SUP_NUM, SUP_NAME FROM SUPPLIER_INFO ORDER BY SUP_NUM
    </select>

    <select id="findBySupNum" parameterType="long" resultMap="supplierResultMap">
        SELECT SUP_NUM, SUP_NAME FROM SUPPLIER_INFO WHERE SUP_NUM = #{supNum}
    </select>

    <select id="countBySupName" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM SUPPLIER_INFO WHERE SUP_NAME = #{supName}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="supNum" keyColumn="SUP_NUM">
        INSERT INTO SUPPLIER_INFO (SUP_NAME) VALUES (#{supName})
    </insert>

    <update id="update">
        UPDATE SUPPLIER_INFO SET SUP_NAME = #{supName} WHERE SUP_NUM = #{supNum}
    </update>

    <delete id="delete">
        DELETE FROM SUPPLIER_INFO WHERE SUP_NUM = #{supNum}
    </delete>

</mapper>
